# prettier は既定で .gitignore も ignore として読むが、format / format:check は
# --ignore-path でこのファイルだけを見るようにしてある（private 側ルートと同じ）。
# あちらの .gitignore の `build/` が packages/canvas/build/（出力ではなくソース）を
# 巻き込み、あちらからの pnpm format がそこを整形しないまま、こちらの CI だけが
# 落ちていたため。整形対象から外すものは、生成物であってもここに書く。

# Build outputs
dist/

# Dependencies
node_modules/

# Cache
.dependency-graph/
.vscode/
.git/
.serena/

# Test output
coverage/

# Generated files
*.min.js
*.min.css

# Package-lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
*.log

# Playwright
test-results/
playwright-report/

# Claude Code local settings
.claude/settings.local.json

# Generated verbatim from the @fontsource stylesheets by build/generateFontsCss.ts.
# Reformatting it would cost the line-for-line diff against upstream; its shape is the
# generator's alone, and check:fonts catches any drift.
packages/canvas/src/fonts.css
