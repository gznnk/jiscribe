		"@playwright/test": "^1.60.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
