{
	"name": "jiscribe-vscode",
	"displayName": "Jiscribe Editor",
	"description": "VSCode extension for editing .jis.json files with SVG canvas",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "jiscribe.editor",
				"displayName": "Jiscribe Canvas Editor",
				"selector": [
					{
						"filenamePattern": "*.jis.json"
					}
				],
				"priority": "default"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@workspace/svg-canvas-2": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^22.10.5",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"esbuild": "^0.24.2"
	}
}
