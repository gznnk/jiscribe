{
	"name": "jiscribe",
	"displayName": "Jiscribe Beta",
	"description": "An AI-friendly, Git-manageable JSON canvas editor. Draw diagrams directly in VS Code and collaborate visually with AI.",
	"publisher": "gznnk",
	"author": {
		"name": "gznnk"
	},
	"homepage": "https://beta.jiscribe.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/gznnk/jiscribe.git",
		"directory": "apps/vscode-extension"
	},
	"bugs": {
		"url": "https://github.com/gznnk/jiscribe/issues"
	},
	"icon": "icon.png",
	"version": "0.7.0",
	"private": true,
	"preview": true,
	"engines": {
		"vscode": "^1.85.0"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"categories": [
		"Visualization",
		"AI",
		"Other"
	],
	"keywords": [
		"diagram",
		"canvas",
		"svg",
		"json",
		"ai",
		"visualization",
		"flowchart",
		"architecture",
		"drawing",
		"jis.json"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "jiscribe.editor",
				"displayName": "Jiscribe Canvas Editor",
				"selector": [
					{
						"filenamePattern": "*.jis"
					},
					{
						"filenamePattern": "*.jiscribe"
					},
					{
						"filenamePattern": "*.jis.json"
					},
					{
						"filenamePattern": "*.jiscribe.json"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "jiscribe.imageEditor",
				"displayName": "Jiscribe Canvas Editor (Image)",
				"selector": [
					{
						"filenamePattern": "*.jis.png"
					},
					{
						"filenamePattern": "*.jis.svg"
					}
				],
				"priority": "default"
			}
		],
		"languages": [
			{
				"id": "json",
				"extensions": [
					".jis",
					".jiscribe"
				]
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"*.jis",
					"*.jiscribe",
					"*.jis.json",
					"*.jiscribe.json"
				],
				"url": "./dist/jiscribe.schema.json"
			}
		],
		"commands": [
			{
				"command": "jiscribe.newEmptyCanvas",
				"title": "New Jiscribe Canvas",
				"category": "Jiscribe"
			},
			{
				"command": "jiscribe.setupAi",
				"title": "Set up AI",
				"category": "Jiscribe"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "jiscribe.newEmptyCanvas",
					"when": "explorerResourceIsFolder",
					"group": "jiscribe@1"
				}
			],
			"commandPalette": [
				{
					"command": "jiscribe.newEmptyCanvas"
				},
				{
					"command": "jiscribe.setupAi"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"package": "vsce package --no-dependencies",
		"publish-ext": "vsce publish --no-dependencies",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"license": "MIT",
	"devDependencies": {
		"@jiscribe/ai-docs": "workspace:*",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/plugin-annotation-shapes": "workspace:*",
		"@jiscribe/plugin-container-shapes": "workspace:*",
		"@jiscribe/plugin-flowchart-shapes": "workspace:*",
		"@jiscribe/plugin-general-shapes": "workspace:*",
		"@jiscribe/plugin-markdown-shape": "workspace:*",
		"@jiscribe/plugin-sticky-shape": "workspace:*",
		"@jiscribe/plugin-uml-shapes": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "catalog:",
		"katex": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
