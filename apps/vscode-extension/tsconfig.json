{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM"],
		"module": "Node16",
		"moduleResolution": "Node16",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"noImplicitReturns": true
	},
	"include": ["src/**/*", "e2e/**/*"],
	"exclude": ["node_modules", "dist"]
}
