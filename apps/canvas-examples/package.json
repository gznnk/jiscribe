{
	"name": "canvas-examples",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite",
		"dev:harness": "vite e2e/harness --configLoader runner",
		"build": "tsc -b && vite build",
		"deploy": "pnpm run build && pnpm dlx wrangler pages deploy dist --project-name=jiscribe-examples --branch=main",
		"lint": "eslint .",
		"preview": "vite preview",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/plugin-annotation-shapes": "workspace:*",
		"@jiscribe/plugin-container-shapes": "workspace:*",
		"@jiscribe/plugin-flowchart-shapes": "workspace:*",
		"@jiscribe/plugin-general-shapes": "workspace:*",
		"@jiscribe/plugin-markdown-shape": "workspace:*",
		"@jiscribe/plugin-sticky-shape": "workspace:*",
		"@jiscribe/plugin-uml-shapes": "workspace:*",
		"katex": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
