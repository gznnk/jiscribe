{
	"name": "jiscribe-mcp",
	"version": "0.12.2",
	"description": "An MCP server that gives an AI the Jiscribe canvas tool set, with a local viewer a person can edit alongside it.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"diagram",
		"canvas",
		"svg",
		"claude",
		"codex",
		"copilot"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gznnk/jiscribe.git",
		"directory": "apps/mcp"
	},
	"homepage": "https://github.com/gznnk/jiscribe/tree/main/apps/mcp#readme",
	"bugs": "https://github.com/gznnk/jiscribe/issues",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"CHANGELOG.md",
		"LICENSE"
	],
	"bin": {
		"jiscribe-mcp": "dist/index.mjs"
	},
	"exports": {
		"./server": "./src/server.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsc --noEmit && vite build && node build.mjs",
		"prepublishOnly": "node verifyDist.mjs",
		"watch": "node build.mjs --watch",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"dev:viewer": "vite"
	},
	"comments": {
		"exports": "./server は同じ workspace の apps/desktop が src/server.ts を直接読むための入口。dist には無いので、公開する tarball では publishConfig が ./package.json だけに差し替える。",
		"devDependencies": "実行時の依存は無い。esbuild が external 無しで dist/index.mjs へ全部バンドルするため、ここに並ぶものは全てビルド時にしか要らない。@jiscribe/doc-schema と @fontsource/* だけは事情が違い、コードから import されない。実行時に node の解決規則で読むもので（read_drawing_guide が返すガイド 2 枚と、doc-tools の fontSourcePackages が読むフォント）、build.mjs が必要なファイルだけ dist/node_modules へ写して配布物に載せる。外すとビルドは通り、read_drawing_guide が error を返し、日本語の計測だけが黙って推定へ落ちる。"
	},
	"devDependencies": {
		"@fontsource/caveat": "5.3.0",
		"@fontsource/klee-one": "5.3.0",
		"@fontsource/noto-sans-jp": "5.3.0",
		"@fontsource/noto-serif-jp": "5.3.0",
		"@fontsource/source-code-pro": "5.3.0",
		"@fontsource/source-sans-3": "5.3.0",
		"@fontsource/source-serif-4": "5.3.0",
		"@jiscribe/ai-tools": "workspace:*",
		"@jiscribe/ai-tools-sdk": "workspace:*",
		"@jiscribe/basic-validators": "workspace:*",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"@jiscribe/doc-schema": "workspace:*",
		"@jiscribe/doc-tools": "workspace:*",
		"@jiscribe/standard-shapes": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react-swc": "catalog:",
		"esbuild": "catalog:",
		"highlight.js": "^11.11.1",
		"katex": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsx": "^4.23.11",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"ws": "^8.21.3",
		"zod": "catalog:"
	}
}
