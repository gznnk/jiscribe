{
	"name": "@jiscribe/plugin-er-shapes",
	"version": "0.0.0",
	"private": true,
	"description": "Provides the ER diagram shapes (erEntity = an entity box with a typed column list) as an external package built on the public canvas API alone (packages/canvas/docs/13-authoring-plugins.md)",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts",
		"./tools": "./src/tools.ts"
	},
	"scripts": {
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
		"dev:harness": "vite e2e/harness --configLoader runner",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jiscribe/basic-validators": "workspace:*",
		"@jiscribe/geometry": "workspace:*"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/ai-tools-sdk": "workspace:*",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"react": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/ai-tools": "workspace:*",
		"@jiscribe/ai-tools-sdk": "workspace:*",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
