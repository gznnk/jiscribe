{
	"name": "@jiscribe/plugin-lucide-icon-shape",
	"version": "0.0.0",
	"private": true,
	"description": "Provides the lucideIcon shape (named pictograms from the Lucide set) as an external package built on the public canvas API alone (packages/canvas/docs/13-authoring-plugins.md)",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"dev:harness": "vite e2e/harness --configLoader runner",
		"generate:icons": "node scripts/generateIconData.mjs",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"react": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@types/react": "catalog:",
		"lucide": "1.31.0",
		"react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
