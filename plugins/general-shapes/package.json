{
	"name": "@workspace/plugin-general-shapes",
	"version": "0.0.0",
	"private": true,
	"description": "記法（flowchart / UML 等）に属さない、実物・人・場を表す汎用ピクトグラム（cloud / actor など）を canvas 公開 API のみで外部パッケージとして提供する。装飾系（star / heart / バナー等）は入れない（docs/05_extensibility/plugin-architecture-requirements.md）",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@workspace/geometry": "workspace:*"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@workspace/canvas": "workspace:*",
		"react": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@types/react": "catalog:",
		"@workspace/canvas": "workspace:*",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
