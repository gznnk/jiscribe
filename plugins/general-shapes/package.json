{
	"name": "@jiscribe/plugin-general-shapes",
	"version": "0.0.0",
	"private": true,
	"description": "Provides, as an external package built on the public canvas API alone, general-purpose pictograms that belong to no notation and stand for things, people and places (15 of them: actor / cloud / server / browserWindow and so on). Decorative shapes (star / heart / banners and the like) are out of scope (packages/canvas/docs/13-authoring-plugins.md)",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"dev:harness": "vite e2e/harness --configLoader runner",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jiscribe/geometry": "workspace:*"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"react": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
