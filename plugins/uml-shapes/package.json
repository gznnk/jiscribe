{
	"name": "@jiscribe/plugin-uml-shapes",
	"version": "0.0.0",
	"private": true,
	"description": "Provides UML-family shapes (record = a box with a title band and any number of compartments) as an external package built on the public canvas API alone (packages/canvas/docs/13-authoring-plugins.md)",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"dev:harness": "vite e2e/harness --configLoader runner",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jiscribe/basic-validators": "workspace:*",
		"@jiscribe/geometry": "workspace:*"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"react": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@playwright/test": "^1.60.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/canvas-sdk": "workspace:*",
		"react": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
