{
	"name": "@workspace/canvas",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./unstable": "./src/unstable.ts",
		"./parser": "./src/parser.ts",
		"./doc-ops": "./src/doc-ops.ts",
		"./png-source": "./src/png-source.ts",
		"./svg-source": "./src/svg-source.ts",
		"./ai/schema": "./ai/jiscribe.schema.json",
		"./ai/guide": "./ai/ai-guide.md",
		"./ai/reference": "./ai/reference.md"
	},
	"scripts": {
		"lint": "eslint .",
		"dev:harness": "vite e2e/harness",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"dep:clean": "rimraf .dependency-graph && mkdir .dependency-graph",
		"dep:list": "madge --extensions ts,tsx,js,jsx src > .dependency-graph/dependency-list.txt",
		"dep:circle": "madge --extensions ts,tsx,js,jsx --circular src > .dependency-graph/circular-dependencies.txt",
		"dep": "npm run dep:clean && npm run dep:list && npm run dep:circle",
		"dep:check": "madge --extensions ts,tsx,js,jsx --circular src"
	},
	"dependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@workspace/basic-validators": "workspace:*",
		"@workspace/geometry": "workspace:*",
		"@workspace/markdown": "workspace:*",
		"@workspace/utility-types": "workspace:*",
		"dompurify": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "^2.1.8",
		"@workspace/plugin-container-shapes": "workspace:*",
		"katex": "catalog:",
		"madge": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
