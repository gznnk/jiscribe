{
	"name": "@jiscribe/canvas",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./fonts.css": "./src/fonts.css",
		"./unstable": "./src/unstable.ts",
		"./doc": "./src/doc.ts",
		"./unstable-doc": "./src/unstable-doc.ts",
		"./png-source": "./src/png-source.ts",
		"./svg-source": "./src/svg-source.ts",
		"./testing": "./e2e/testing.ts",
		"./testing/playwright-config": "./e2e/testing-playwright-config.ts",
		"./testing/vite-config": "./e2e/testing-vite-config.ts",
		"./testing/harness": "./e2e/testing-harness.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"dev:harness": "vite e2e/harness",
		"generate:fonts": "node build/generateFontsCss.ts",
		"check:fonts": "node build/generateFontsCss.ts --check",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"dep:clean": "rimraf .dependency-graph && mkdir .dependency-graph",
		"dep:list": "madge --extensions ts,tsx,js,jsx src > .dependency-graph/dependency-list.txt",
		"dep:circle": "madge --extensions ts,tsx,js,jsx --circular src > .dependency-graph/circular-dependencies.txt",
		"dep": "npm run dep:clean && npm run dep:list && npm run dep:circle",
		"dep:check": "madge --extensions ts,tsx,js,jsx --circular src"
	},
	"dependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@fontsource/caveat": "5.3.0",
		"@fontsource/klee-one": "5.3.0",
		"@fontsource/noto-sans-jp": "5.3.0",
		"@fontsource/noto-serif-jp": "5.3.0",
		"@fontsource/source-code-pro": "5.3.0",
		"@fontsource/source-sans-3": "5.3.0",
		"@fontsource/source-serif-4": "5.3.0",
		"@jiscribe/basic-validators": "workspace:*",
		"@jiscribe/doc": "workspace:*",
		"@jiscribe/geometry": "workspace:*",
		"@jiscribe/utility-types": "workspace:*",
		"dompurify": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "^4.1.10",
		"jsdom": "catalog:",
		"madge": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
