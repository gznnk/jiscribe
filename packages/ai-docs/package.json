{
	"name": "@jiscribe/ai-docs",
	"version": "1.0.0",
	"private": true,
	"description": "Generated JSON schema and AI authoring docs for the shipped jiscribe shape set",
	"type": "module",
	"exports": {
		"./schema": "./assets/jiscribe.schema.json",
		"./guide": "./assets/ai-guide.md",
		"./reference": "./assets/reference.md"
	},
	"scripts": {
		"generate": "tsx generator/src/main.ts",
		"check": "tsx generator/src/main.ts --check",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/plugin-annotation-shapes": "workspace:*",
		"@jiscribe/plugin-container-shapes": "workspace:*",
		"@jiscribe/plugin-flowchart-shapes": "workspace:*",
		"@jiscribe/plugin-general-shapes": "workspace:*",
		"@jiscribe/plugin-markdown-shape": "workspace:*",
		"@jiscribe/plugin-sticky-shape": "workspace:*",
		"@jiscribe/plugin-uml-shapes": "workspace:*",
		"@types/node": "catalog:",
		"prettier": "3.9.6",
		"tsx": "^4.23.11",
		"typescript": "catalog:"
	}
}
