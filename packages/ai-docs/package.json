{
	"name": "@workspace/ai-docs",
	"version": "1.0.0",
	"private": true,
	"description": "Generated JSON schema and AI authoring docs for the shipped jiscribe shape set",
	"type": "module",
	"exports": {
		"./schema": "./assets/jiscribe.schema.json",
		"./guide": "./assets/ai-guide.md",
		"./reference": "./assets/reference.md"
	},
	"scripts": {
		"generate": "tsx generator/src/main.ts",
		"check": "tsx generator/src/main.ts --check",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@workspace/canvas": "workspace:*",
		"@workspace/plugin-flowchart-shapes": "workspace:*",
		"@workspace/plugin-markdown-shape": "workspace:*",
		"@workspace/plugin-uml-shapes": "workspace:*",
		"prettier": "^3.7.4",
		"tsx": "^4.22.4",
		"typescript": "catalog:"
	}
}
