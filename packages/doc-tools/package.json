{
	"name": "@jiscribe/doc-tools",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "tsc --noEmit"
	},
	"comments": {
		"@fontsource/*": "Not imported as modules: the Node measurer reads the .woff files and the unicode-range of the @font-face CSS off disk, resolved through Node's own resolution (measure/fontSourcePackages.ts). They are the very files @jiscribe/canvas ships to the browser, which is what keeps a headless measurement on the same faces as the drawing."
	},
	"dependencies": {
		"@fontsource/caveat": "5.3.0",
		"@fontsource/klee-one": "5.3.0",
		"@fontsource/noto-sans-jp": "5.3.0",
		"@fontsource/noto-serif-jp": "5.3.0",
		"@fontsource/source-code-pro": "5.3.0",
		"@fontsource/source-sans-3": "5.3.0",
		"@fontsource/source-serif-4": "5.3.0",
		"@jiscribe/ai-docs": "workspace:*",
		"@jiscribe/canvas": "workspace:*",
		"@jiscribe/geometry": "workspace:*",
		"@jiscribe/standard-shapes": "workspace:*",
		"ajv": "^8.20.0",
		"fontkit": "^2.0.4"
	},
	"devDependencies": {
		"@types/fontkit": "^2.0.9",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
