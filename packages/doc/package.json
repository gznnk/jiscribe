{
	"name": "@jiscribe/doc",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./unstable": "./src/unstable.ts",
		"./png-source": "./src/png-source.ts",
		"./svg-source": "./src/svg-source.ts",
		"./parse": "./src/parse/index.ts",
		"./ops": "./src/ops/index.ts",
		"./*": "./src/*.ts"
	},
	"comments": {
		"exports./*": "The wildcard is for @jiscribe/canvas only: the canvas layers map every built-in Doc type one by one, so they reach modules no curated entry names. Nothing else declares this package as a dependency, which is what keeps ./, ./unstable, ./png-source and ./svg-source the surface everyone else sees."
	},
	"scripts": {
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "tsc --noEmit",
		"dep:check": "madge --extensions ts,tsx,js,jsx --circular src"
	},
	"dependencies": {
		"@jiscribe/basic-validators": "workspace:*",
		"@jiscribe/geometry": "workspace:*",
		"@jiscribe/utility-types": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"madge": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
