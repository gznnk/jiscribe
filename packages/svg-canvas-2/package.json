{
	"name": "@workspace/svg-canvas-2",
	"version": "0.0.0",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"typecheck": "tsc --noEmit",
		"dep:clean": "rimraf .dependency-graph && mkdir .dependency-graph",
		"dep:list": "madge --extensions ts,tsx,js,jsx src > .dependency-graph/dependency-list.txt",
		"dep:circle": "madge --extensions ts,tsx,js,jsx --circular src > .dependency-graph/circular-dependencies.txt",
		"dep": "npm run dep:clean && npm run dep:list && npm run dep:circle",
		"dep:check": "madge --extensions ts,tsx,js,jsx --circular src"
	},
	"dependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@workspace/basic-validators": "workspace:*",
		"@workspace/geometry": "workspace:*",
		"@workspace/markdown": "workspace:*",
		"@workspace/utility-types": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^2.1.8",
		"@vitest/ui": "^2.1.8",
		"madge": "^8.0.0",
		"rimraf": "^6.0.1",
		"typescript": "catalog:",
		"vitest": "^2.1.8"
	}
}
