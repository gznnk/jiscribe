{
	"name": "@jiscribe/canvas-sdk",
	"version": "0.0.0",
	"private": true,
	"description": "Shape-authoring kit that can be written against the public canvas API alone. Plugins look at this and @jiscribe/canvas (packages/canvas/docs/13-authoring-plugins.md)",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./doc": "./src/doc.ts",
		"./testing": "./src/testing.ts",
		"./testing/e2e": "./src/testing-e2e.ts",
		"./testing/playwright-config": "./src/testing-playwright-config.ts",
		"./testing/vite-config": "./src/testing-vite-config.ts",
		"./testing/harness": "./src/testing-harness.ts"
	},
	"scripts": {
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jiscribe/geometry": "workspace:*"
	},
	"peerDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"react": "catalog:"
	},
	"devDependencies": {
		"@emotion/react": "catalog:",
		"@emotion/styled": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@jiscribe/canvas": "workspace:*",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
